                                 ///////////////INITIALIZATION//////////////////
                                 START:
00046e dbf7                      	rcall SPI_INIT
00046f dbc4                      	rcall TWI_SPEED_INIT
000470 d00c                      	rcall TIMER_INIT
000471 dc55                      	rcall JOY_RIGHT_INIT          ; Initializes AD conversion for right joystick
000472 d017                      	rcall SRAM_INIT               ; Initializes data, clears board
000473 dc34                      	rcall SEND_BOARD_INIT         ; Initializes X pointer for interuptions
                                 
000474 d033                      	rcall LOAD_LVL1               ; Lvl 1 -> LEVEL
000475 d04f                      	rcall LOAD_BOARD              ; LEVEL -> BOARD
000476 dd2c                      	rcall CURSOR_SEND             ; CURSOR -> BOARD
000477 ddd4                      	rcall AUDIO_INIT
000478 9478                      	sei					          ;Allow interrupts globally
                                 //////////////////PROGRAM//////////////////////
                                 MAIN:
000479 d067                      	rcall LOAD_DAMATRIX           ; BOARD - > DAMATRIX
00047a dc5c                      	rcall KEY_READ		
00047b dce8                      	rcall KEY_SEND
00047c cffc                      	rjmp MAIN
                                 ////////////////INTERUPT TIMER/////////////////
                                 TIMER_INIT:
00047d e00c                      	ldi r16, (1<<WGM12) | (1<<CS12)
00047e 9300 0081                 	sts TCCR1B, r16
000480 e000                      	ldi r16, HIGH(COUNTER)
000481 9300 0089                 	sts OCR1AH, r16
000483 e406                      	ldi r16, LOW(COUNTER)
000484 9300 0088                 	sts OCR1AL, r16
000486 e002                      	ldi r16, (1<<OCIE1A)
000487 9300 006f                 	sts TIMSK1, r16
000489 9508                      	ret
                                 ////////////////CLEAR BOARD///////////////////
                                 SRAM_INIT:
00048a 930f                      	push r16
00048b 931f                      	push r17
00048c 93ef                      	push ZL
00048d 93ff                      	push ZH
                                 
00048e d006                      	rcall DATA_INIT                ; Initializes SRAM data
00048f d010                      	rcall BOARD_INIT               ; Clears board
                                 
000490 91ff                      	pop ZH
000491 91ef                      	pop ZL
000492 911f                      	pop r17
000493 910f                      	pop r16
000494 9508                      	ret
                                 ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                                 DATA_INIT:
000495 e001                      	ldi r16, 1
000496 9300 0158                 	sts COLUMN, r16
000498 2700                      	clr r16
000499 9300 0160                 	sts SELECT_FLAG, r16
00049b 9300 015d                 	sts CURSOR_POSITION, r16
00049d 9300 015f                 	sts CURSOR_COUNTER, r16
00049f 9508                      	ret
                                 ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                                 BOARD_INIT:
0004a0 e0f1                      	ldi ZH, HIGH(BOARD)
0004a1 e0e0                      	ldi ZL, LOW(BOARD)
0004a2 2700                      	clr r16
0004a3 e410                      	ldi r17, 64
                                 CLR_NEXT_SEG:
0004a4 9301                      	st Z+,r16
0004a5 951a                      	dec r17
0004a6 f7e9                      	brne CLR_NEXT_SEG
0004a7 9508                      	ret	
                                 ///////////////LEVEL SELECTION/////////////////
                                 LOAD_LVL1:
0004a8 930f                      	push r16
0004a9 931f                      	push r17
                                 
0004aa e008                      	ldi r16, HIGH(LVL1*2)
0004ab e212                      	ldi r17, LOW(LVL1*2)
0004ac e028                      	ldi r18, HIGH(LVL1_DONE*2)
0004ad e33c                      	ldi r19, LOW(LVL1_DONE*2)
0004ae d00d                      	rcall LOAD_LEVEL              ; Saves level in SRAM
                                 
0004af 911f                      	pop r17
0004b0 910f                      	pop r16
0004b1 9508                      	ret
                                 ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                                 LOAD_LVL2:
0004b2 930f                      	push r16
0004b3 931f                      	push r17
                                 
0004b4 e008                      	ldi r16, HIGH(LVL2*2)
0004b5 e71c                      	ldi r17, LOW(LVL2*2)
0004b6 e028                      	ldi r18, HIGH(LVL2_DONE*2)
0004b7 e936                      	ldi r19, LOW(LVL2_DONE*2)
0004b8 d003                      	rcall LOAD_LEVEL              ; Saves level in SRAM
                                 
0004b9 911f                      	pop r17
0004ba 910f                      	pop r16
0004bb 9508                      	ret
                                 ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                                 LOAD_LEVEL:
0004bc 9300 0159                 	sts LEVEL, r16
0004be 9310 015a                 	sts LEVEL+1, r17
0004c0 9320 015b                 	sts LEVEL_DONE, r18
0004c2 9330 015c                 	sts LEVEL_DONE+1, r19
0004c4 9508                      	ret
                                 ///////////////LEVEL -> BOARD//////////////////
                                 LOAD_BOARD:
0004c5 930f                      	push r16
0004c6 93cf                      	push YL
0004c7 93df                      	push YH
0004c8 93ef                      	push ZL
0004c9 93ff                      	push ZH
                                 
0004ca d007                      	rcall LOAD_BOARD_INIT
0004cb d00d                      	rcall LOAD_BOARD_LEVEL
                                 
0004cc 91ff                      	pop ZH
0004cd 91ef                      	pop ZL
0004ce 91df                      	pop YH
0004cf 91cf                      	pop YL
0004d0 910f                      	pop r16
0004d1 9508                      	ret
                                 ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                                 LOAD_BOARD_INIT:
0004d2 e0d1                      	ldi YH, HIGH(BOARD)
0004d3 e0c0                      	ldi YL, LOW(BOARD)
0004d4 91f0 0159                 	lds ZH, LEVEL
0004d6 91e0 015a                 	lds ZL, LEVEL+1
0004d8 9508                      	ret
                                 ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                                 LOAD_BOARD_LEVEL:
0004d9 9105                      	lpm r16, Z+                       ; Spaces
0004da 3f0f                      	cpi r16, $FF
0004db f021                      	breq BOARD_LOADED
0004dc 0fc0                      	add YL, r16
0004dd 9105                      	lpm r16, Z+                       ; Color
0004de 9309                      	st Y+, r16
0004df cff9                      	rjmp LOAD_BOARD_LEVEL
                                 BOARD_LOADED:
0004e0 9508                      	ret	
                                 ///////////////BOARD -> DAMATRIX//////////////////
                                 LOAD_DAMATRIX:
0004e1 930f                      	push r16
0004e2 931f                      	push r17
0004e3 932f                      	push r18
0004e4 933f                      	push r19
0004e5 934f                      	push r20
0004e6 93cf                      	push YL
0004e7 93df                      	push YH
0004e8 93ef                      	push ZL
0004e9 93ff                      	push ZH
                                 
0004ea d00b                      	rcall LOAD_DAMATRIX_INIT
0004eb d00f                      	rcall LOAD_DAMATRIX_BOARD
                                 
0004ec 91ff                      	pop ZH
0004ed 91ef                      	pop ZL
0004ee 91df                      	pop YH
0004ef 91cf                      	pop YL
0004f0 914f                      	pop r20
0004f1 913f                      	pop r19
0004f2 912f                      	pop r18
0004f3 911f                      	pop r17
0004f4 910f                      	pop r16
                                 
0004f5 9508                      	ret
                                 ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                                 LOAD_DAMATRIX_INIT:
0004f6 e0d1                      	ldi YH, HIGH(BOARD)
0004f7 e0c0                      	ldi YL, LOW(BOARD)
0004f8 e0f1                      	ldi ZH, HIGH(DAMATRIX)
0004f9 e4e0                      	ldi ZL, LOW(DAMATRIX)
0004fa 9508                      	ret
                                 ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                                 LOAD_DAMATRIX_BOARD:
0004fb e008                      	ldi r16, 8
                                 NEXT_DAMATRIX_ROW:
0004fc d006                      	rcall LOAD_DAMATRIX_ROW    
0004fd 9311                      	st Z+, r17
0004fe 9321                      	st Z+, r18
0004ff 9331                      	st Z+, r19 
000500 950a                      	dec r16
000501 f7d1                      	brne NEXT_DAMATRIX_ROW
000502 9508                      	ret
                                 ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                                 LOAD_DAMATRIX_ROW:
000503 930f                      	push r16
                                 
000504 e048                      	ldi r20, 8
                                 NEXT_DAMATRIX_BYTE:
000505 9109                      	ld r16, Y+
000506 9507                      	ror r16
000507 9517                      	ror r17                   ; Blue
000508 9507                      	ror r16
000509 9527                      	ror r18                   ; Green
00050a 9507                      	ror r16
00050b 9537                      	ror r19                   ; Red
00050c 954a                      	dec r20
00050d f7b9                      	brne NEXT_DAMATRIX_BYTE
                                 
00050e 910f                      	pop r16
00050f 9508                      	ret
                                 ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                                 POINT_AT_CURSOR:
000510 931f                      	push r17
000511 e0d1                      	ldi YH, HIGH(BOARD)
000512 e0c0                      	ldi YL, LOW(BOARD)
000513 9110 015d                 	lds r17, CURSOR_POSITION
000515 0fc1                      	add YL, r17
000516 911f                      	pop r17
000517 9508                      	ret
                                 ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                                 CHECK_LEVEL_DONE:
000518 e0d1                      	ldi YH, HIGH(BOARD)
000519 e0c0                      	ldi YL, LOW(BOARD)
00051a 91f0 015b                 	lds ZH, LEVEL_DONE
00051c 91e0 015c                 	lds ZL, LEVEL_DONE+1
00051e 2722                      	clr r18
                                 CLD_LOOP:
00051f 9523                      	inc r18                   ; Loop counter
000520 9105                      	lpm r16, Z+	
000521 9119                      	ld r17, Y+
000522 7017                      	andi r17, 7
000523 1701                      	cp r16, r17
000524 f3d1                      	breq CLD_LOOP
                                 
000525 9110 015d                 	lds r17, CURSOR_POSITION  
000527 9513                      	inc r17                  
