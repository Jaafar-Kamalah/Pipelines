                                 ; EECR - EEPROM Control Register
                                 .equ	EERE	= 0	; EEPROM Read Enable
                                 .equ	EEPE	= 1	; EEPROM Write Enable
                                 .equ	EEMPE	= 2	; EEPROM Master Write Enable
                                 .equ	EERIE	= 3	; EEPROM Ready Interrupt Enable
                                 .equ	EEPM0	= 4	; EEPROM Programming Mode Bit 0
                                 .equ	EEPM1	= 5	; EEPROM Programming Mode Bit 1
                                 
                                 
                                 
                                 ; ***** LOCKSBITS ********************************************************
                                 .equ	LB1	= 0	; Lock bit
                                 .equ	LB2	= 1	; Lock bit
                                 .equ	BLB01	= 2	; Boot Lock bit
                                 .equ	BLB02	= 3	; Boot Lock bit
                                 .equ	BLB11	= 4	; Boot lock bit
                                 .equ	BLB12	= 5	; Boot lock bit
                                 
                                 
                                 ; ***** FUSES ************************************************************
                                 ; LOW fuse bits
                                 .equ	CKSEL0	= 0	; Select Clock Source
                                 .equ	CKSEL1	= 1	; Select Clock Source
                                 .equ	CKSEL2	= 2	; Select Clock Source
                                 .equ	CKSEL3	= 3	; Select Clock Source
                                 .equ	SUT0	= 4	; Select start-up time
                                 .equ	SUT1	= 5	; Select start-up time
                                 .equ	CKOUT	= 6	; Clock output
                                 .equ	CKDIV8	= 7	; Divide clock by 8
                                 
                                 ; HIGH fuse bits
                                 .equ	BOOTRST	= 0	; Select reset vector
                                 .equ	BOOTSZ0	= 1	; Select boot size
                                 .equ	BOOTSZ1	= 2	; Select boot size
                                 .equ	EESAVE	= 3	; EEPROM memory is preserved through chip erase
                                 .equ	WDTON	= 4	; Watchdog Timer Always On
                                 .equ	SPIEN	= 5	; Enable Serial programming and Data Downloading
                                 .equ	DWEN	= 6	; debugWIRE Enable
                                 .equ	RSTDISBL	= 7	; External reset disable
                                 
                                 ; EXTENDED fuse bits
                                 .equ	BODLEVEL0	= 0	; Brown-out Detector trigger level
                                 .equ	BODLEVEL1	= 1	; Brown-out Detector trigger level
                                 .equ	BODLEVEL2	= 2	; Brown-out Detector trigger level
                                 
                                 
                                 
                                 ; ***** CPU REGISTER DEFINITIONS *****************************************
                                 .def	XH	= r27
                                 .def	XL	= r26
                                 .def	YH	= r29
                                 .def	YL	= r28
                                 .def	ZH	= r31
                                 .def	ZL	= r30
                                 
                                 
                                 
                                 ; ***** DATA MEMORY DECLARATIONS *****************************************
                                 .equ	FLASHEND	= 0x3fff	; Note: Word address
                                 .equ	IOEND	= 0x00ff
                                 .equ	SRAM_START	= 0x0100
                                 .equ	SRAM_SIZE	= 2048
                                 .equ	RAMEND	= 0x08ff
                                 .equ	XRAMEND	= 0x0000
                                 .equ	E2END	= 0x03ff
                                 .equ	EEPROMEND	= 0x03ff
                                 .equ	EEADRBITS	= 10
                                 #pragma AVRPART MEMORY PROG_FLASH 32768
                                 #pragma AVRPART MEMORY EEPROM 1024
                                 #pragma AVRPART MEMORY INT_SRAM SIZE 2048
                                 #pragma AVRPART MEMORY INT_SRAM START_ADDR 0x100
                                 
                                 
                                 
                                 ; ***** BOOTLOADER DECLARATIONS ******************************************
                                 .equ	NRWW_START_ADDR	= 0x3800
                                 .equ	NRWW_STOP_ADDR	= 0x3fff
                                 .equ	RWW_START_ADDR	= 0x0
                                 .equ	RWW_STOP_ADDR	= 0x37ff
                                 .equ	PAGESIZE	= 64
                                 .equ	FIRSTBOOTSTART	= 0x3f00
                                 .equ	SECONDBOOTSTART	= 0x3e00
                                 .equ	THIRDBOOTSTART	= 0x3c00
                                 .equ	FOURTHBOOTSTART	= 0x3800
                                 .equ	SMALLBOOTSTART	= FIRSTBOOTSTART
                                 .equ	LARGEBOOTSTART	= FOURTHBOOTSTART
                                 
                                 
                                 
                                 ; ***** INTERRUPT VECTORS ************************************************
                                 .equ	INT0addr	= 0x0002	; External Interrupt Request 0
                                 .equ	INT1addr	= 0x0004	; External Interrupt Request 1
                                 .equ	PCI0addr	= 0x0006	; Pin Change Interrupt Request 0
                                 .equ	PCI1addr	= 0x0008	; Pin Change Interrupt Request 0
                                 .equ	PCI2addr	= 0x000a	; Pin Change Interrupt Request 1
                                 .equ	WDTaddr	= 0x000c	; Watchdog Time-out Interrupt
                                 .equ	OC2Aaddr	= 0x000e	; Timer/Counter2 Compare Match A
                                 .equ	OC2Baddr	= 0x0010	; Timer/Counter2 Compare Match A
                                 .equ	OVF2addr	= 0x0012	; Timer/Counter2 Overflow
                                 .equ	ICP1addr	= 0x0014	; Timer/Counter1 Capture Event
                                 .equ	OC1Aaddr	= 0x0016	; Timer/Counter1 Compare Match A
                                 .equ	OC1Baddr	= 0x0018	; Timer/Counter1 Compare Match B
                                 .equ	OVF1addr	= 0x001a	; Timer/Counter1 Overflow
                                 .equ	OC0Aaddr	= 0x001c	; TimerCounter0 Compare Match A
                                 .equ	OC0Baddr	= 0x001e	; TimerCounter0 Compare Match B
                                 .equ	OVF0addr	= 0x0020	; Timer/Couner0 Overflow
                                 .equ	SPIaddr	= 0x0022	; SPI Serial Transfer Complete
                                 .equ	URXCaddr	= 0x0024	; USART Rx Complete
                                 .equ	UDREaddr	= 0x0026	; USART, Data Register Empty
                                 .equ	UTXCaddr	= 0x0028	; USART Tx Complete
                                 .equ	ADCCaddr	= 0x002a	; ADC Conversion Complete
                                 .equ	ERDYaddr	= 0x002c	; EEPROM Ready
                                 .equ	ACIaddr	= 0x002e	; Analog Comparator
                                 .equ	TWIaddr	= 0x0030	; Two-wire Serial Interface
                                 .equ	SPMRaddr	= 0x0032	; Store Program Memory Read
                                 
                                 .equ	INT_VECTORS_SIZE	= 52	; size in words
                                 
                                 #endif  /* _M328PDEF_INC_ */
                                 
                                 ; ***** END OF FILE ******************************************************
000000 c46d                      
                                 ////////////////////INTERRUPTS/////////////////
                                 	.org OC1Aaddr
000016 c06d                      	rjmp SEND_BOARD                 
                                 	.org INT_VECTORS_SIZE
                                 	.equ COUNTER = 70				
                                 ////////////////////FILES//////////////////////
                                 	.include "TWI-Drivers.asm"
                                 
                                 TWI_SPEED_INIT:                   ; Körs en gång i "COLD"
000034 e00f                      	ldi r16,$0F                   ; Bitrate speed (FF is slowest)
000035 9300 00b8                 	sts TWBR,r16
000037 9508                      	ret
                                 ;;;;;;;;;;;;;;;|r16-adress||r17-send|;;;;;;;;;;;;;;;;;;
                                 TWI_SEND:
000038 d00d                      	rcall TWI_OPEN                ; Start-tillstånd
000039 0f00                      	lsl r16                       ; WRITE bit i adressen
00003a d012                      	rcall TWI_WRITE               ; Skickar address
00003b 2f01                      	mov r16,r17                   
00003c d010                      	rcall TWI_WRITE               ; Skickar data
00003d d01d                      	rcall TWI_CLOSE               ; Stop-tillstånd
00003e 9508                      	ret
                                 ;;;;;;;;;;;;;|r16-adress||r16-recieve|;;;;;;;;;;;;;;;;;
                                 TWI_RECEIVE:
00003f d006                      	rcall TWI_OPEN                ; Start-tillstånd
000040 0f00                      	lsl r16
000041 6001                      	ori r16,1                     ; READ bit i adressen
000042 d00a                      	rcall TWI_WRITE               ; Skickar adress
000043 d010                      	rcall TWI_READ                ; Läser in data
000044 d016                      	rcall TWI_CLOSE               ; Stop-tillstånd
000045 9508                      	ret
                                 /////////////////////HELP ROUTINES/////////////////////
                                 TWI_OPEN:
000046 930f                      	push r16
000047 ea04                      	ldi r16,(1<<TWINT)|(1<<TWEN)|(1<<TWSTA)
000048 9300 00bc                 	sts TWCR,r16
00004a d016                      	rcall WAIT_FOR_TWINT
00004b 910f                      	pop r16
00004c 9508                      	ret
                                 ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                                 TWI_WRITE:
00004d 9300 00bb                 	sts TWDR,r16
00004f e804                      	ldi r16,(1<<TWINT)|(1<<TWEN)
000050 9300 00bc                 	sts TWCR,r16
000052 d00e                      	rcall WAIT_FOR_TWINT
000053 9508                      	ret
                                 ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                                 TWI_READ:
000054 e804                      	ldi r16,(1<<TWINT)|(1<<TWEN)
000055 9300 00bc                 	sts TWCR,r16
000057 d009                      	rcall WAIT_FOR_TWINT
000058 9100 00bb                 	lds r16,TWDR
00005a 9508                      	ret
                                 ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                                 TWI_CLOSE:
00005b 930f                      	push r16
00005c e904                      	ldi r16,(1<<TWINT)|(1<<TWEN)|(1<<TWSTO)
00005d 9300 00bc                 	sts TWCR,r16
00005f 910f                      	pop r16
000060 9508                      	ret
                                 ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                                 WAIT_FOR_TWINT:
000061 9100 00bc                 	lds r16,TWCR
000063 ff07                      	sbrs r16,TWINT
000064 cffc                      	rjmp WAIT_FOR_TWINT
000065 9508                      	ret
                                 	.include "SPI-Drivers.asm"
                                 
                                 	.equ  MOSI = PB3
                                 	.equ SCK = PB5
                                 ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                                 SPI_INIT:
000066 930f                      	push r16
                                 
000067 e20c                      	ldi r16, (1<<MOSI)|(1<<SCK)|(1<<SS)
000068 b904                      	out DDRB, r16                          ; Sets MOSI, SCK, SS as output
000069 e503                      	ldi r16, (1<<SPE)|(1<<MSTR)|(1<<SPR0)|(1<<SPR1)
00006a bd0c                      	out SPCR, r16                          ; Enable SPI, Master, fck/16
                                 
00006b 910f                      	pop r16
00006c 9508                      	ret
                                 ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                                 SPI_SEND:
00006d 930f                      	push r16
                                 
00006e bd0e                      	out SPDR, r16
                                 SPI_TRANSMIT_WAIT:
00006f b50d                      	in r16, SPSR
000070 ff07                      	sbrs r16, SPIF
000071 cffd                      	rjmp SPI_TRANSMIT_WAIT 
                                 
000072 910f                      	pop r16
000073 9508                      	ret 
                                 	.include "delays.asm"
                                 
                                 WAIT:
000074 93ef                      	push ZL
000075 93ff                      	push ZH
000076 27ee                      	clr ZL
000077 27ff                      	clr ZH
                                 WAIT_LOOP:
000078 9634                      	adiw ZL,4             ; ca 16 millisekunder
000079 f7f1                      	brne WAIT_LOOP
00007a 91ff                      	pop ZH
00007b 91ef                      	pop ZL
00007c 9508                      	ret
                                 ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                                 LONG_WAIT:
00007d 930f                      	push r16
00007e e708                      	ldi r16,120
                                 LONG_WAIT_LOOP:
00007f dff4                      	rcall WAIT
000080 950a                      	dec r16              ; ca 0.492 sekunder
000081 f7e9                      	brne LONG_WAIT_LOOP
000082 910f                      	pop r16
000083 9508                      	ret
                                 	.include "DAMatrix.asm"
                                 
                                 	.equ SS = PB2
                                 ///////////////Print DAMATRIX//////////////////
                                 SEND_BOARD:
000084 930f                      	push r16
000085 b70f                      	in r16, SREG
000086 930f                      	push r16
000087 931f                      	push r17
000088 93ff                      	push ZH
000089 93ef                      	push ZL
                                 
00008a d009                      	rcall SEND_CURSOR
00008b d01f                      	rcall SEND_COLUMN
00008c d030                      	rcall COLUMN_COUNTER
                                 
00008d 91ef                      	pop ZL
00008e 91ff                      	pop ZH
00008f 911f                      	pop r17
000090 910f                      	pop r16
000091 bf0f                      	out SREG, r16
000092 910f                      	pop r16
000093 9518                      	reti
                                 ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                                 SEND_CURSOR:
000094 9100 015f                 	lds r16, CURSOR_COUNTER
000096 9503                      	inc r16
000097 9300 015f                 	sts CURSOR_COUNTER, r16
000099 f409                      	brne SKIP_SEND_CURSOR
00009a d001                      	rcall CURSOR_BLINK
                                 SKIP_SEND_CURSOR:
00009b 9508                      	ret
                                 ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                                 CURSOR_BLINK:
00009c d473                      	rcall POINT_AT_CURSOR
00009d 8108                      	ld r16, Y
00009e 3000                      	cpi r16, black
00009f f421                      	brne CURSOR_OFF
0000a0 9100 015e                 	lds r16, CURSOR_COLOR
0000a2 8308                      	st Y, r16
0000a3 c002                      	rjmp BLINK_DONE
                                 CURSOR_OFF:
0000a4 2700                      	clr r16
0000a5 8308                      	st Y, r16
                                 BLINK_DONE:
0000a6 d43a                      	rcall LOAD_DAMATRIX
0000a7 9508                      	ret
                                 ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                                 SEND_BOARD_INIT:
0000a8 e0b1                      	ldi XH,HIGH(DAMATRIX)
0000a9 e4a0                      	ldi XL,LOW(DAMATRIX)
0000aa 9508                      	ret
                                 ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                                 SEND_COLUMN:
0000ab 931f                      	push r17
                                 
0000ac e013                      	ldi r17,3
                                 NEXT_COLOR:
0000ad 910d                      	ld r16,X+
0000ae dfbe                      	rcall SPI_SEND
0000af 951a                      	dec r17
0000b0 f7e1                      	brne NEXT_COLOR
0000b1 d002                      	rcall COLUMN_TRANSMITION
                                 
0000b2 911f                      	pop r17
0000b3 9508                      	ret
                                 ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                                 COLUMN_TRANSMITION:
0000b4 9100 0158                 	lds r16, COLUMN       
0000b6 9500                      	com r16
0000b7 940e 006d                 	call SPI_SEND
0000b9 982a                      	cbi PORTB, SS
0000ba 9a2a                      	sbi PORTB, SS
0000bb 982a                      	cbi PORTB, SS 
0000bc 9508                      	ret
                                 ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                                 COLUMN_COUNTER:
0000bd 9100 0158                 	lds r16, COLUMN
0000bf 0f00                      	lsl r16
0000c0 3000                      	cpi r16,0
0000c1 f411                      	brne NO_DAMATRIX_RESET
                                 
0000c2 dfe5                      	rcall SEND_BOARD_INIT
0000c3 e001                      	ldi r16, 1
                                 NO_DAMATRIX_RESET:
0000c4 9300 0158                 	sts COLUMN, r16
0000c6 9508                      	ret
                                 	.include "joystick.asm"
                                 
                                 JOY_RIGHT_INIT:	
0000c7 e807                      	ldi r16,(1<<ADEN)|7              ; AD-enable, 128 prescaler
0000c8 9300 007a                 	sts ADCSRA,r16
0000ca 9508                      	ret
                                 ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                                 ADC_READ8:
0000cb 9100 007a                 	lds r16,ADCSRA
0000cd 6400                      	ori r16,(1<<ADSC)      ; Starta omvandling
0000ce 9300 007a                 	sts ADCSRA,r16
                                 ADC_BUSY:
0000d0 9100 007a                 	lds r16,ADCSRA
0000d2 fd06                      	sbrc r16,ADSC          ; Skip om omvandling klar
0000d3 cffc                      	rjmp ADC_BUSY
                                 	;Omvanlding klar
0000d4 9100 0079                 	lds r16, ADCH		   ; 0-255 steg, 1.9mV/steg
                                 	.include "key_read.asm"
0000d6 9508                      
                                 KEY_READ:
0000d7 d00f                      	rcall KEY
0000d8 2300                      	tst r16
0000d9 f7e9                      	brne KEY_READ              ; old key still pressed
                                 KEY_WAIT_FOR_PRESS:
0000da d17f                      	rcall FAILURE_INIT         ; resets failure sound flag 
0000db d00b                      	rcall KEY   
0000dc d194                      	rcall CHECK_FOR_FAILURE    ; plays failure sound if block is triggered        
0000dd 2f10                      	mov r17,r16
0000de 2300                      	tst r16	
0000df f3d1                      	breq KEY_WAIT_FOR_PRESS	   ; no key pressed
0000e0 3005                      	cpi r16, 5
0000e1 f3a9                      	breq KEY_READ              ; block triggered
0000e2 df91                      	rcall WAIT
0000e3 d003                      	rcall KEY                 
0000e4 1701                      	cp r16,r17                 
0000e5 f7a1                      	brne KEY_WAIT_FOR_PRESS    ; kontaktstuds
                                 	;new key value available
0000e6 9508                      	ret
                                 ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                                 KEY:
0000e7 e207                      	ldi r16, $27                     ; L2 BUTTON
0000e8 df56                      	rcall TWI_RECEIVE
0000e9 730f                      	andi r16,0b00111111              ; mask out L2
0000ea 3307                      	cpi r16,$37                      ; $37 == L2 pressed
0000eb f411                      	brne NOT_L2
0000ec e00a                      	ldi r16, 10                      ; 10 is key for select in KEY_SEND
0000ed c018                      	rjmp KEY_EXIT
                                 NOT_L2:
0000ee 2700                      	clr r16
                                 
0000ef e600                      	ldi	r16,(1<<REFS0)|(1<<ADLAR)|0  ; RIGHT JOYSTICK X AXIS
0000f0 9300 007c                 	sts ADMUX,r16
0000f2 dfd8                      	rcall ADC_READ8
0000f3 d013                      	rcall KEY_CONVERT                ; 8 / -8 key if JOY == right/left
0000f4 3000                      	cpi r16, 0
0000f5 f011                      	breq VERTICAL_AXIS
0000f6 d02b                      	rcall HORISONTAL_BORDER_BLOCK
0000f7 c00a                      	rjmp KEY_DONE
                                 
                                 VERTICAL_AXIS:
0000f8 e601                      	ldi	r16,(1<<REFS0)|(1<<ADLAR)|1  ; RIGHT JOYSTICK Y AXIS
0000f9 9300 007c                 	sts ADMUX,r16
0000fb dfcf                      	rcall ADC_READ8
0000fc d00a                      	rcall KEY_CONVERT
0000fd 9505                      	asr r16
0000fe 9505                      	asr r16
0000ff 9505                      	asr r16
000100 9501                      	neg r16                          ; 1 / -1 key if JOY == down / up
000101 d00f                      	rcall VERTICAL_BORDER_BLOCK
                                 
                                 KEY_DONE:
000102 2300                      	tst r16
000103 f011                      	breq KEY_EXIT                    ; Skip block_checks if nothing pressed
000104 d02a                      	rcall SELECT_BLOCK               ; Block if selected and moving into other color
000105 d03d                      	rcall CONNECTION_BLOCK         ; Block if connected and moving in direction other than back
                                 KEY_EXIT:
000106 9508                      	ret
                                 ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                                 KEY_CONVERT:
000107 3001                      	cpi r16, 1
000108 f030                      	brlo LEFT
000109 3c08                      	cpi r16, 200
00010a f410                      	brsh RIGHT
00010b e000                      	ldi r16,0
00010c c003                      	rjmp KEY_CONVERT_DONE
                                 RIGHT:
00010d e008                      	ldi r16, 8                ; right 
00010e c001                      	rjmp KEY_CONVERT_DONE
                                 LEFT:
00010f ef08                      	ldi R16, -8               ; left
                                 KEY_CONVERT_DONE:
000110 9508                      	ret
                                 ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                                 VERTICAL_BORDER_BLOCK:
000111 931f                      	push r17                  ; r17 used for kontaktstudshantering
000112 9110 015d                 	lds r17, CURSOR_POSITION
000114 3f0f                      	cpi r16, -1               ; Up direction: block if on 0,8,16,24,32,40,48,56
000115 f019                      	breq BLOCK_NEXT_ROW
000116 3001                      	cpi r16, 1                ; Down direction: block if on 7,15,23,31,39,47,55,63
000117 f441                      	brne VBB_EXIT             
000118 9513                      	inc r17                   ; Make down direction divisible by 8
                                 
                                 BLOCK_NEXT_ROW:
000119 2311                      	tst r17
00011a f019                      	breq VBB_BLOCK           ; Block if r17 is divisible with 8
00011b f022                      	brmi VBB_EXIT
00011c 5018                      	subi r17, 8
00011d cffb                      	rjmp BLOCK_NEXT_ROW
                                 
                                 VBB_BLOCK:
00011e e005                      	ldi r16, 5               ; 5 == flag for block
00011f d145                      	rcall FAILURE_COUNT      ; Failure sound counter
                                 VBB_EXIT:
000120 911f                      	pop r17
000121 9508                      	ret
                                 ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                                 HORISONTAL_BORDER_BLOCK:
000122 931f                      	push r17                 ; r17 used for kontaktstudshantering
000123 9110 015d                 	lds r17, CURSOR_POSITION
000125 0f10                      	add r17, r16
000126 3010                      	cpi r17, 0
000127 f018                      	brlo HBB_BLOCK
000128 3410                      	cpi r17, 64
000129 f408                      	brsh HBB_BLOCK
00012a c002                      	rjmp HBB_EXIT
                                 
                                 HBB_BLOCK:
00012b e005                      	ldi r16, 5              ; 5 == flag for block
00012c d138                      	rcall FAILURE_COUNT     ; Failure sound counter 
                                 HBB_EXIT:
00012d 911f                      	pop r17
00012e 9508                      	ret
                                 ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                                 SELECT_BLOCK:
00012f 931f                      	push r17              ; r17 used for kontaktstudshantering
                                 
000130 9110 0160                 	lds r17, SELECT_FLAG
000132 3f1f                      	cpi r17, $FF
000133 f469                      	brne SB_EXIT          ; exit if nothing selected
                                 
000134 d3db                      	rcall POINT_AT_CURSOR
000135 0fc0                      	add Yl, r16
000136 8118                      	ld r17, Y
000137 7017                      	andi r17, 7
000138 9120 015e                 	lds r18, CURSOR_COLOR
00013a 7027                      	andi r18, 7
                                 
00013b 1712                      	cp r17, r18
00013c f021                      	breq SB_EXIT         ; do not block if moving to same color tile
00013d 3010                      	cpi r17, black
00013e f011                      	breq SB_EXIT         ; do not block if moving to black tile
                                 
                                 SB_BLOCK:
00013f e005                      	ldi r16, 5           ; 5 == flag for block
000140 d124                      	rcall FAILURE_COUNT  ; Failure sound counter 
                                 
                                 SB_EXIT:	
000141 911f                      	pop r17
000142 9508                      	ret
                                 ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                                 CONNECTION_BLOCK:    
000143 931f                      	push r17
                                 
000144 9110 0160                 	lds r17, SELECT_FLAG
000146 3f1f                      	cpi r17, $FF
000147 f7c9                      	brne SB_EXIT             ; exit if nothing selected
                                 
000148 9110 015e                 	lds r17, CURSOR_COLOR
00014a fd14                      	sbrc r17, 4            
00014b c016                      	rjmp CB_EXIT             ; exit if cursor is on line and not point
                                 	
00014c d3c3                      	rcall POINT_AT_CURSOR
00014d 0fc0                      	add YL, r16
00014e 8128                      	ld r18, Y
00014f 7027                      	andi r18, 7
000150 7017                      	andi r17, 7
000151 1721                      	cp r18, r17           
000152 f079                      	breq CB_EXIT             ; exit if moving back onto line of same color
                                 
000153 1bc0                      	sub YL, r16             
000154 ede6                      	ldi ZL, LOW(ADJACENT*2)
000155 e0f8                      	ldi ZH, HIGH(ADJACENT*2)
                                 NEXT_ADJACENT:
000156 9125                      	lpm r18, Z+              ; check all directions of cursor
                                 
000157 2322                      	tst r18
000158 f049                      	breq CB_EXIT             ; if no lines attached to point do not block 
                                 
000159 0fc2                      	add YL, r18
00015a 8138                      	ld r19, Y
00015b 7037                      	andi r19, 7
00015c 1731                      	cp r19, r17              ; if r19 == r17 this point has a line attached
00015d f011                      	breq CB_BLOCK 
00015e 1bc2                      	sub YL, r18
00015f cff6                      	rjmp NEXT_ADJACENT
                                 
                                 
                                 CB_BLOCK:
000160 e005                      	ldi r16, 5              ; 5 == flag for block
000161 d103                      	rcall FAILURE_COUNT     ; Failure sound counter 
                                 CB_EXIT:	
000162 911f                      	pop r17
                                 	.include "key_send.asm"
000163 9508                      
                                 KEY_SEND:
000164 300a                      	cpi r16, 10
000165 f021                      	breq SELECT_KEY
000166 d006                      	rcall JOY_SEND
000167 d075                      	rcall SHORTCUT           ; If adjacent to two lines of same color make shortcut
000168 d074                      	rcall SHORTCUT           ; Check again (in cases where three lines adjacent two shortcuts can be made)
000169 c002                      	rjmp SEND_KEY_DONE
                                 SELECT_KEY:  
00016a d013                      	rcall SELECT_SWITCH
00016b d3ac                      	rcall CHECK_LEVEL_DONE        ; Continiues to next level if current level done
                                 SEND_KEY_DONE:
00016c 9508                      	ret
                                 ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                                 JOY_SEND:
00016d d118                      	rcall SEND_BEEP               ; Sound for allowed movement
00016e d3a1                      	rcall POINT_AT_CURSOR
00016f 9110 015d                 	lds r17, CURSOR_POSITION
000171 9310 0161                 	sts PREV_CURSOR_POSITION, r17 ; Update previous cursor position
                                 
000173 9120 015e                 	lds r18, CURSOR_COLOR
000175 302f                      	cpi r18, white                
000176 f409                      	brne KEEP_CURSOR_COLOR        ; If cursor white == no color is under cursor
000177 e020                      	ldi r18, black                ; so previous color should be black
                                 
                                 KEEP_CURSOR_COLOR:
000178 8328                      	st Y, r18                     ; else previous color should be CURSOR_COLOR
000179 0f10                      	add r17, r16
00017a 9310 015d                 	sts CURSOR_POSITION, r17      ; update CURSOR_POSITION
                                 
                                 SKIP_CURSOR_SAVE:
00017c d026                      	rcall CURSOR_SEND
00017d 9508                      	ret
                                 ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                                 SELECT_SWITCH:
00017e 9100 0160                 	lds r16, SELECT_FLAG
000180 2300                      	tst r16
000181 f441                      	brne SELECT_HIGH       ; Unselecting is always allowed
                                 
000182 9110 015e                 	lds r17, CURSOR_COLOR
000184 301f                      	cpi r17, white
000185 f039                      	breq SELECT_SEND_DONE  ; Selecting is not allowed if cursor is white
                                 
000186 ff13                      	sbrs r17, 3
000187 c005                      	rjmp SELECT_SEND_DONE ; Selecting is not allowed on unselectable points
                                 	
000188 ff14                      	sbrs r17, 4
000189 d004                      	rcall RESET_COLOR     ; Remove all lines if selecting a startpoint
                                 SELECT_HIGH:
00018a 9500                      	com r16
00018b 9300 0160                 	sts SELECT_FLAG, r16
                                 SELECT_SEND_DONE:
00018d 9508                      	ret
                                 ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                                 RESET_COLOR:
00018e 930f                      	push r16
00018f 9120 015e                 	lds r18, CURSOR_COLOR
000191 7027                      	andi r18, 7
000192 e400                      	ldi r16, 64          ; loop counter
000193 e0d1                      	ldi YH, HIGH(BOARD)
000194 e0c0                      	ldi YL, LOW(BOARD)
                                 
                                 RC_NEXT_COLOR:
000195 8118                      	ld r17, Y
000196 7017                      	andi r17, 7
000197 1712                      	cp r17, r18  
000198 f429                      	brne RC_SKIP         ; if not same color do not change
000199 8118                      	ld r17, Y
00019a 6018                      	ori r17, 8           ; make selectable
00019b fd14                      	sbrc r17, 4
00019c 2711                      	clr r17              ; if line clear
                                 	
00019d 8318                      	st Y, r17
                                 RC_SKIP:
00019e 95c3                      	inc YL               ; next board position
00019f 950a                      	dec r16
0001a0 f7a1                      	brne RC_NEXT_COLOR
                                 
0001a1 910f                      	pop r16
0001a2 9508                      	ret
                                 ///////////////CURSOR -> BOARD/////////////////
                                 CURSOR_SEND:
0001a3 d36c                      	rcall POINT_AT_CURSOR
                                 
0001a4 9110 0160                 	lds r17, SELECT_FLAG
0001a6 3f1f                      	cpi r17, $FF
0001a7 f411                      	brne NOT_SELECTED
0001a8 d009                      	rcall SELECT_SEND             ; if moving line
0001a9 c004                      	rjmp COLORED_CURSOR
                                 
                                 NOT_SELECTED:
0001aa 8108                      	ld r16, Y                
0001ab 3000                      	cpi r16, black                ; if cursor on black then CURSOR_COLOR = white
0001ac f409                      	brne COLORED_CURSOR           ; else CURSOR_COLOR = color cursor is on
0001ad e00f                      	ldi r16, white                
                                 COLORED_CURSOR:
0001ae 9300 015e                 	sts CURSOR_COLOR, r16         
0001b0 8308                      	st Y, r16
0001b1 9508                      	ret
                                 ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                                 SELECT_SEND:
0001b2 d003                      	rcall PREVIOUS_VALUE_SEND_INIT
0001b3 d00b                      	rcall PREVIOUS_VALUE_SEND
0001b4 d01e                      	rcall CURR_VALUE_SEND
0001b5 9508                      	ret
                                 ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                                 PREVIOUS_VALUE_SEND_INIT:
0001b6 8118                      	ld r17, Y                       ; Current cursor value (curr)
0001b7 9100 015d                 	lds r16, CURSOR_POSITION
0001b9 1bc0                      	sub YL, r16                     
0001ba 9100 0161                 	lds r16, PREV_CURSOR_POSITION
0001bc 0fc0                      	add YL, r16                     
0001bd 8108                      	ld r16, Y                       ; Previous cursor value (prev)
0001be 9508                      	ret
                                 ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                                 PREVIOUS_VALUE_SEND:
0001bf 7007                      	andi r16, 7                     ; Special case 1
0001c0 1710                      	cp r17, r16                     ; if (curr = unselectable, non line) and (prev = same color as curr) 
0001c1 f069                      	breq PREV_POS_REMOVED           ; delete prev
                                 
                                 	                                ; Special case 2
0001c2 8128                      	ld r18, Y                       ; prev
0001c3 6008                      	ori r16, 8
0001c4 1720                      	cp r18, r16                     ; if prev not a selectable non line
0001c5 f421                      	brne NOT_SPECIAL_CASE           ; jump out
                                 
0001c6 7007                      	andi r16, 7
0001c7 6100                      	ori r16, 16
0001c8 1710                      	cp r17, r16                     ; else if curr is unselectable line
0001c9 f041                      	breq PVS_EXIT                   ; do not change prev
                                 
                                 NOT_SPECIAL_CASE:
0001ca 8108                      	ld r16, Y 
0001cb 7f17                      	andi r17, 0b11110111            ;  curr value with masked selectable flag
0001cc 7f07                      	andi r16, 0b11110111            ;  prev value with masked selectable flag
0001cd 1710                      	cp r17, r16                     ;  If (curr = line) and (prev = line of same color) delete prev
0001ce f409                      	brne PREV_POS_UNSELECTABLE      ;  else make prev unselectable
                                 
                                 PREV_POS_REMOVED:
0001cf 2700                      	clr r16                         
                                 PREV_POS_UNSELECTABLE:
0001d0 7f07                      	andi r16, 0b11110111            
0001d1 8308                      	st Y, r16
                                 PVS_EXIT:
0001d2 9508                      	ret
                                 ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                                 CURR_VALUE_SEND:
0001d3 d33c                      	rcall POINT_AT_CURSOR
0001d4 9100 015e                 	lds r16, CURSOR_COLOR 
0001d6 6100                      	ori r16, 16            ; line flag
                                 
0001d7 8118                      	ld r17, Y
0001d8 3010                      	cpi r17, black
0001d9 f011                      	breq CURR_VALUE_EXIT   ; if curr is black or a line
0001da ff14                      	sbrs r17, 4            ; r16 = CURSOR_COLOR + line flag set
0001db 700f                      	andi r16, 0b00001111   ; else r16 = CURSOR_COLOR
                                 CURR_VALUE_EXIT:
0001dc 9508                      	ret                    ; r16 is later set to new CURSOR_COLOR
                                 ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                                 SHORTCUT:
0001dd 9100 015d                 	lds r16, CURSOR_POSITION
0001df 930f                      	push r16
                                 
0001e0 9110 0160                 	lds r17, SELECT_FLAG   
0001e2 3f1f                      	cpi r17, $FF
0001e3 f411                      	brne SHORTCUT_EXIT              ; exit if nothing selected
                                 
0001e4 d005                      	rcall SHORTCUT_CHECK_INIT
0001e5 d00c                      	rcall SHORTCUT_CHECK
                                 
                                 SHORTCUT_EXIT:
0001e6 910f                          pop r16
0001e7 9300 015d                 	sts CURSOR_POSITION, r16   ; Restore CURSOR_POSITION to original value
0001e9 9508                      	ret
                                 ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                                 SHORTCUT_CHECK_INIT: 
0001ea ede6                      	ldi ZL, LOW(ADJACENT*2)   ; 8, -8, 1, -1, 0
0001eb e0f8                      	ldi ZH, HIGH(ADJACENT*2)
                                 
0001ec 9120 015e                 	lds r18, CURSOR_COLOR
0001ee 7027                      	andi r18, 7
                                 
0001ef 2733                      	clr r19                   ; matches counter
0001f0 d31f                      	rcall POINT_AT_CURSOR     ; Y pointer pointing at cursor position
0001f1 9508                      	ret
                                 ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                                 SHORTCUT_CHECK:    
0001f2 9105                      	lpm r16, Z+                 ; 8, -8, 1, -1, 0
0001f3 2300                      	tst r16 
0001f4 f079                      	breq SC_DONE
                                 
0001f5 93c0 015d                 	sts CURSOR_POSITION, YL
                                 
0001f7 df19                      	rcall VERTICAL_BORDER_BLOCK
0001f8 df29                      	rcall HORISONTAL_BORDER_BLOCK
0001f9 3005                      	cpi r16,5
0001fa f409                      	brne NOT_OUTSIDE_BORDERS
0001fb 2700                      	clr r16
                                 
                                 NOT_OUTSIDE_BORDERS:
0001fc 0fc0                      	add YL, r16
0001fd 8118                      	ld r17, Y
0001fe 701f                      	andi r17, 15    ; line flag masked out
0001ff 1bc0                      	sub YL, r16
                                 
000200 1712                      	cp r17, r18     ; if r17 is CURSOR_COLOR with or without line flag set -> count a match
000201 f409                      	brne NOT_MATCH
                                 MATCH:
000202 9533                      	inc r19         ; Match counter
                                 NOT_MATCH:
000203 cfee                      	rjmp SHORTCUT_CHECK
                                 
                                 SC_DONE:                 ; (at least one match once color selected) (impossible to have 4 or more matches)
000204 fd31                      	sbrc r19, 1          ; if there are 2 or 3 matches send shortcut
000205 d001                      	rcall SHORTCUT_SEND    
000206 9508                      	ret
                                 ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                                 SHORTCUT_SEND:
000207 d00c                      	rcall SHORTCUT_SEND_INIT
                                 
                                 SHORTCUT_SEND_LOOP:
000208 d015                      	rcall FIND_SHORTCUT_LINE
000209 3f0f                      	cpi r16, $FF
00020a f031                      	breq SHORTCUT_SEND_EXIT   ; if shortcut is done
                                 
00020b 2711                      	clr r17                   
00020c 8318                      	st Y, r17                 ; delete tail   
00020d 9543                      	inc r20                   ; increase deletion counter
                                 
00020e 0fc5                      	add YL, r21               ; move to the next line segment
00020f 2755                      	clr r21
000210 cff7                      	rjmp SHORTCUT_SEND_LOOP
                                 SHORTCUT_SEND_EXIT:
000211 93c0 0161                 	sts PREV_CURSOR_POSITION, YL ; PREV_CURSOR_POSITION has to be uptadet since it otherwise points at a point that now is black
000213 9508                      	ret
                                 ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                                 SHORTCUT_SEND_INIT:
000214 e0d1                      	ldi YH, HIGH(BOARD)
000215 e0c0                      	ldi YL, LOW(BOARD)
000216 9100 0161                 	lds r16, PREV_CURSOR_POSITION
000218 0fc0                      	add YL, r16                    ; Y pointer pointing at previous cursor position
                                 
000219 9130 015d                 	lds r19, CURSOR_POSITION
00021b 2744                      	clr r20                        ; deletion counter
00021c 2755                      	clr r21                        ; next line segment
00021d 9508                      	ret
                                 ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                                 FIND_SHORTCUT_LINE:
00021e 93c0 015d                 	sts CURSOR_POSITION, YL      ; update CURSOR_POSITION so BLOCK routines work
000220 ede6                      	ldi ZL, LOW(ADJACENT*2)     
000221 e0f8                      	ldi ZH, HIGH(ADJACENT*2)     ; 8, -8, 1, -1, 0
                                 
                                 SS_NEXT_ADJACENT:
000222 9105                      	lpm r16, Z+                  ; 8, -8, 1, -1, 0
000223 2300                      	tst r16
000224 f099                      	breq FSL_EXIT
                                       
000225 deeb                      	rcall VERTICAL_BORDER_BLOCK
000226 defb                      	rcall HORISONTAL_BORDER_BLOCK
000227 3005                      	cpi r16,5                      ; if adjacent value moves Y pointer over board borders
000228 f3c9                      	breq SS_NEXT_ADJACENT          ; skip value
                                 
000229 0fc0                      	add YL, r16
00022a 8118                      	ld r17, Y
00022b 701f                      	andi r17, 15
                                 
00022c 3042                      	cpi r20, 2                    ; if deletion counter >= 2, look for starting position
00022d f028                      	brlo NOT_END_OF_LINE
00022e 17c3                      	cp YL, r19                    ; if YL on original cursor position
00022f f419                      	brne NOT_END_OF_LINE
000230 1bc0                      	sub YL, r16
000231 ef0f                      	ldi r16, $FF                  ; flag for if to exit SHORTCUT_SEND_LOOP
000232 c005                      	rjmp FSL_EXIT
                                 
                                 NOT_END_OF_LINE:
000233 1bc0                      	sub YL, r16
000234 1712                      	cp r17, r18                  ; if r17 == CURSOR_COLOR with masked out flags
000235 f409                      	brne SKIP_DELETER
000236 2f50                      	mov r21, r16                 ; next line segment
                                 SKIP_DELETER:
000237 cfea                      	rjmp SS_NEXT_ADJACENT
                                 FSL_EXIT:
                                 	.include "audio.asm"
000238 9508                      
                                 
                                 	.equ	A0 = 142
                                 	.equ	B0 = 127
                                 	.equ	C = 119
                                 	.equ	D = 106
                                 	.equ	Di = 100
                                 	.equ	E = 95
                                 	.equ	F = 89
                                 	.equ	G = 80
                                 	.equ	Gi = 75
                                 	.equ	A = 71
                                 	.equ	B = 63
                                 	.equ	C2 = 60
                                 	.equ	D2 = 53
                                 	.equ	Di2 = 50
                                 	.equ	E2 = 47
                                 	.equ	F2 = 45
                                 	.equ	E3 = 23
                                 	
                                 WIN:
000239 7700
00023a 7700
00023b 7700
00023c 5f01
00023d 5f00
00023e 5f00
00023f 5001
000240 5000
000241 5000
000242 3c01
000243 0101
000244 0001
000245 3f3c
000246 5047
000247 5f59
000248 776a
000249 fe00                      	.db		0, 119, 0, 119, 0, 119, 1, 95, 0, 95, 0, 95, 1, 80, 0, 80, 0, 80, 1, 60, 1, 1, 1, 0, 60, 63, 71, 80, 89, 95, 106, 119, 0, $FE
                                 
                                 FAILURE:
00024a 8e77
00024b 00fe                      	.db		119, 142, $FE, 0
                                 
                                 AUDIO_INIT:
00024c 930f                      	push	r16
00024d e20e                      	ldi		r16, (1<<MOSI)|(1<<SCK)|(1<<SS)|(1<<SPEAKER)
00024e b904                      	out		DDRB, r16
00024f 940e 0255                 	call	TUNE_INIT
000251 940e 025a                 	call	FAILURE_INIT
000253 910f                      	pop		r16
000254 9508                      	ret
                                 
                                 TUNE_INIT:
000255 e0d1                      	ldi		YH, HIGH(TUNE)
000256 e6c3                      	ldi		YL, LOW(TUNE)
000257 e000                      	ldi		r16, 0
000258 8308                      	st		Y, r16
000259 9508                      	ret
                                 
                                 FAILURE_INIT:
00025a 93df                      	push	YH
00025b 93cf                      	push	YL
00025c 930f                      	push	r16
00025d e0d1                      	ldi		YH, HIGH(FAILURE_COUNTER)
00025e e6c4                      	ldi		YL, LOW(FAILURE_COUNTER)
00025f e000                      	ldi		r16, 0
000260 8308                      	st		Y, r16
000261 910f                      	pop		r16
000262 91cf                      	pop		YL
000263 91df                      	pop		YH
000264 9508                      	ret
                                 
                                 FAILURE_COUNT:
000265 93df                      	push	YH
000266 93cf                      	push	YL
000267 930f                      	push	r16
000268 e0d1                      	ldi		YH, HIGH(FAILURE_COUNTER)
000269 e6c4                      	ldi		YL, LOW(FAILURE_COUNTER)
00026a 8108                      	ld		r16, Y
00026b 9503                      	inc		r16
00026c 8308                      	st		Y, r16
00026d 910f                      	pop		r16
00026e 91cf                      	pop		YL
00026f 91df                      	pop		YH
000270 9508                      	ret
                                 
                                 CHECK_FOR_FAILURE:
000271 e0d1                      	ldi		YH, HIGH(FAILURE_COUNTER)
000272 e6c4                      	ldi		YL, LOW(FAILURE_COUNTER)
000273 8128                      	ld		r18, Y
000274 2322                      	tst		r18
000275 f011                      	breq	NO_FAILURE
000276 d040                      	rcall	SEND_FAILURE
000277 dfe2                      	rcall	FAILURE_INIT
                                 NO_FAILURE:
000278 9508                      	ret
                                 
                                 STOP_MUSIC:
000279 e0d1                      	ldi		YH, HIGH(TUNE)
00027a e6c3                      	ldi		YL, LOW(TUNE)
00027b e000                      	ldi		r16, 0
00027c 8308                      	st		Y, r16
00027d 9508                      	ret
                                 
                                 AUDIO_TIMER_INIT:
00027e e400                      	ldi		r16, (1<<COM1A0)
00027f 9300 0080                 	sts		TCCR1A, r16
000281 9508                      	ret
                                 
                                 AUDIO_TIMER_STOP:
000282 e000                      	ldi		r16, 0
000283 9300 0080                 	sts		TCCR1A, r16
000285 9508                      	ret
                                 
                                 SEND_BEEP:
000286 93df                      	push	YH
000287 93cf                      	push	YL
000288 930f                      	push	r16
000289 e0d1                      	ldi		YH, HIGH(TUNE)
00028a e6c3                      	ldi		YL, LOW(TUNE)
00028b 8108                      	ld		r16, Y
00028c 3000                      	cpi		r16, 0
00028d f431                      	brne	NO_BEEP
00028e 940e 027e                 	call	AUDIO_TIMER_INIT
000290 940e 03f1                 	call	AUDIO_WAIT_SHORT
000292 940e 0282                 	call	AUDIO_TIMER_STOP
                                 NO_BEEP:
000294 910f                      	pop		r16
000295 91cf                      	pop		YL
000296 91df                      	pop		YH
000297 9508                      	ret
                                 
                                 SEND_WIN:
000298 93ff                      	push	ZH
000299 93ef                      	push	ZL
00029a 93df                      	push	YH
00029b 93cf                      	push	YL
00029c 930f                      	push	r16
00029d 931f                      	push	r17
00029e e0f4                      	ldi		ZH, HIGH(WIN*2)
00029f e7e2                      	ldi		ZL, LOW(WIN*2)
0002a0 9115                      	lpm		r17, Z+
                                 SEND_WIN_NEXT:
0002a1 940e 027e                 	call	AUDIO_TIMER_INIT
0002a3 940e 02d6                 	call	FIND_TONE
0002a5 940e 0401                 	call	AUDIO_WAIT_LONG
0002a7 9115                      	lpm		r17, Z+
0002a8 3f1e                      	cpi		r17, $FE
0002a9 f7b9                      	brne	SEND_WIN_NEXT
0002aa 940e 0282                 	call	AUDIO_TIMER_STOP
0002ac 940e 0279                 	call	STOP_MUSIC
0002ae 940e 03e8                 	call	RESET_COUNTER
0002b0 911f                      	pop		r17
0002b1 910f                      	pop		r16
0002b2 91cf                      	pop		YL
0002b3 91df                      	pop		YH
0002b4 91ef                      	pop		ZL
0002b5 91ff                      	pop		ZH
0002b6 9508                      	ret
                                 
                                 SEND_FAILURE:
0002b7 93ff                      	push	ZH
0002b8 93ef                      	push	ZL
0002b9 93df                      	push	YH
0002ba 93cf                      	push	YL
0002bb 930f                      	push	r16
0002bc 931f                      	push	r17
0002bd e0f4                      	ldi		ZH, HIGH(FAILURE*2)
0002be e9e4                      	ldi		ZL, LOW(FAILURE*2)
0002bf 9115                      	lpm		r17, Z+
                                 SEND_FAILURE_NEXT:	
0002c0 940e 02d6                 	call	FIND_TONE
0002c2 940e 027e                 	call	AUDIO_TIMER_INIT
0002c4 940e 0401                 	call	AUDIO_WAIT_LONG
0002c6 9115                      	lpm		r17, Z+
0002c7 3f1e                      	cpi		r17, $FE
0002c8 f7b9                      	brne	SEND_FAILURE_NEXT
0002c9 940e 0282                 	call	AUDIO_TIMER_STOP
0002cb 940e 0279                 	call	STOP_MUSIC
0002cd 940e 03e8                 	call	RESET_COUNTER
0002cf 911f                      	pop		r17
0002d0 910f                      	pop		r16
0002d1 91cf                      	pop		YL
0002d2 91df                      	pop		YH
0002d3 91ef                      	pop		ZL
0002d4 91ff                      	pop		ZH
0002d5 9508                      	ret
                                 
                                 FIND_TONE:
0002d6 381e                      	cpi		r17, 142
0002d7 f421                      	brne	NOT_A0
0002d8 940e 0341                 	call	SET_A0
0002da 940c 0340                 	jmp		FIND_TONE_DONE
                                 NOT_A0:
0002dc 371f                      	cpi		r17, 127
0002dd f421                      	brne	NOT_B0
0002de 940e 034a                 	call	SET_B0
0002e0 940c 0340                 	jmp		FIND_TONE_DONE
                                 NOT_B0:
0002e2 3717                      	cpi		r17, 119
0002e3 f421                      	brne	NOT_C
0002e4 940e 0353                 	call	SET_C
0002e6 940c 0340                 	jmp		FIND_TONE_DONE
                                 NOT_C:
0002e8 361a                      	cpi		r17, 106
0002e9 f421                      	brne	NOT_D
0002ea 940e 035c                 	call	SET_D
0002ec 940c 0340                 	jmp		FIND_TONE_DONE
                                 NOT_D:
0002ee 3614                      	cpi		r17, 100
0002ef f421                      	brne	NOT_Di
0002f0 940e 0365                 	call	SET_Di
0002f2 940c 0340                 	jmp		FIND_TONE_DONE
                                 NOT_Di:
0002f4 351f                      	cpi		r17, 95
0002f5 f421                      	brne	NOT_E
0002f6 940e 036e                 	call	SET_E
0002f8 940c 0340                 	jmp		FIND_TONE_DONE
                                 NOT_E:
0002fa 3519                      	cpi		r17, 89
0002fb f421                      	brne	NOT_F
0002fc 940e 0377                 	call	SET_F
0002fe 940c 0340                 	jmp		FIND_TONE_DONE
                                 NOT_F:
000300 3510                      	cpi		r17, 80
000301 f421                      	brne	NOT_G
000302 940e 0380                 	call	SET_G
000304 940c 0340                 	jmp		FIND_TONE_DONE
                                 NOT_G:
000306 341b                      	cpi		r17, 75
000307 f421                      	brne	NOT_Gi
000308 940e 0389                 	call	SET_Gi
00030a 940c 0340                 	jmp		FIND_TONE_DONE
                                 NOT_Gi:
00030c 3417                      	cpi		r17, 71
00030d f421                      	brne	NOT_A
00030e 940e 0392                 	call	SET_A
000310 940c 0340                 	jmp		FIND_TONE_DONE
                                 NOT_A:
000312 331f                      	cpi		r17, 63
000313 f421                      	brne	NOT_B
000314 940e 039b                 	call	SET_B
000316 940c 0340                 	jmp		FIND_TONE_DONE
                                 NOT_B:
000318 331c                      	cpi		r17, 60
000319 f421                      	brne	NOT_C2
00031a 940e 03a4                 	call	SET_C2
00031c 940c 0340                 	jmp		FIND_TONE_DONE
                                 NOT_C2:
00031e 3315                      	cpi		r17, 53
00031f f421                      	brne	NOT_D2
000320 940e 03ad                 	call	SET_D2
000322 940c 0340                 	jmp		FIND_TONE_DONE
                                 NOT_D2:
000324 3312                      	cpi		r17, 50
000325 f421                      	brne	NOT_Di2
000326 940e 03b6                 	call	SET_Di2
